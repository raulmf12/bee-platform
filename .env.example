# Credenciais do Supabase — copiar para .env.local e preencher
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# App ID do Facebook/Meta (público) — botão "Conectar Instagram".
# O App Secret NÃO vai aqui: fica nos Secrets do Supabase (FACEBOOK_APP_SECRET).
VITE_FACEBOOK_APP_ID=
